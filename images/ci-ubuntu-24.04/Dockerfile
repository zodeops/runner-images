# Generated by scripts/render.sh from images/ci-ubuntu-24.04/Dockerfile.in. Edit that file, not this one.
# ci-ubuntu-24.04: the Zode base image plus the toolset GitHub-hosted
# ubuntu-24.04 runners carry, so `runs-on: zode-<size>` jobs behave like
# `runs-on: ubuntu-24.04`. Every `runs-on: zode-*` job uses this line.
#
# FROM zode: each RUN runs in the build VM with `bash -lc` as root. COPY and
# ADD are refused, so everything is inline. ARGs are build-time only; ENV is
# kept for every login shell and in /etc/environment.
FROM zode

# Set by the publish workflow to the release version (YYYYMMDD.run).
ARG IMAGE_VERSION=dev
# The node's package mirror (apt, npm, PyPI, Docker Hub).
ARG ZODE_MIRROR=http://172.16.0.1:5000

# AWS CLI v2. AWS publishes a PGP signature, not a checksum: this sha256 is of
# the zip whose signature checked out against the AWS CLI Team key.
ARG AWS_CLI_VERSION=2.40.1
ARG AWS_CLI_SHA256=fddb097a8ea197dc9beed9e4426ef99aded612a52df64581e079b6e8817e1d24
# Kubernetes tools. Checksums as published by each project.
ARG KUBECTL_VERSION=1.37.2
ARG KUBECTL_SHA256=c04487523e7aa7d1493f7808174c899db93d7a9cf57531420cd76b9bd415f8f4
ARG HELM_VERSION=3.22.1
ARG HELM_SHA256=896cf63684a42a723d61c980369d6e588330927deb13676ca0d85006dd6da0ea
ARG KUSTOMIZE_VERSION=5.8.3
ARG KUSTOMIZE_SHA256=cb9e31198d3f63b44848bd0afc4c8efc56e6cfef9c93a4a39a211940e6decd61
ARG YQ_VERSION=4.54.3
ARG YQ_SHA256=129534601871538efe0ba4c5e62a34fb1d5f469bcb975c4fddeb467d82974973
# Eclipse Temurin JDKs (github.com/adoptium release assets).
ARG TEMURIN_17_VERSION=17.0.21+9
ARG TEMURIN_17_SHA256=8b9b611d917e3dfd8419d3566b5949226f69b052fed7e109c1368add1dfe8711
