ARG TEMURIN_21_SHA256=d7f5d5cf865a2902b70ff549b97586a7d3f234e016f041ab447ea740c7d66d1c
# Hosted tool cache: actions/node-versions and actions/python-versions
# release assets, the same builds GitHub's runners carry. RELEASE is the tag.
ARG NODE_22_RELEASE=22.23.4-39619033003
ARG NODE_22_SHA256=05c182e45510cb6c5dcf62b208abffbafe9af22b73101cbf5f14d15c8dc5ff0f
ARG NODE_24_RELEASE=24.22.2-40806817314
ARG NODE_24_SHA256=8c19ab1e5bd4432f3d8526406cc9af2f70eac3290175c48818e98c787023a7d4
ARG PYTHON_312_RELEASE=3.12.16-40260402378
ARG PYTHON_312_SHA256=dec61ed20cd3e71143f1642ef9966945dea8ae4f3e96b306205a710da4f2191a
ARG PYTHON_313_RELEASE=3.13.18-40336726450
